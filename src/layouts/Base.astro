---
import '../styles/global.css';
import { url } from '../lib/content';
import { words, languages, languageNames, localePath, type Language } from '../lib/i18n';
interface Props { title?: string; description?: string; active?: string; language?: Language; mapPage?: boolean; translations?: Partial<Record<Language, string>> }
const { title, description = 'Notes on a new city. A personal diary of Strasbourg, favourite places, and finding a little bit of home.', active = '', language = 'en', mapPage = false, translations } = Astro.props;
const t = words[language];
const sections: Record<string, string> = { journal: 'journal/', map: '' };
const languageUrl = (lang: Language) => translations?.[lang] || url(localePath(lang, sections[active] || ''));
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#631d31" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{title ? `${title} — COMPRENDS PAS` : 'COMPRENDS PAS — A little lost. A little at home.'}</title>
  </head>
  <body class:list={{ 'map-page': mapPage }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href={url(localePath(language))} aria-label={`Comprends Pas — ${t.home}`}>comprends pas<span class="brand-dot">.</span></a>
      <nav aria-label="Main navigation">
        <a href={url(localePath(language))} aria-current={active === 'map' ? 'page' : undefined}>{t.map}</a>
        <a href={url(localePath(language, 'journal/'))} aria-current={active === 'journal' ? 'page' : undefined}>{t.diary}</a>
      </nav>
      <nav class="language-selector" aria-label={t.selectLanguage}>{languages.map(lang => <a href={languageUrl(lang)} lang={lang} hreflang={lang} aria-label={languageNames[lang]} aria-current={lang === language ? 'true' : undefined}>{lang.toUpperCase()}</a>)}</nav>
    </header>
    <main id="main"><slot /></main>
    {!mapPage && <footer class="site-footer wrap">
      <div><a class="wordmark" href={url(localePath(language))}>comprends pas.</a><p>{t.footer}</p></div>
      <div class="footer-meta"><span>{t.love}</span><a href={url('credits/')}>{t.credits}</a></div>
    </footer>}
  </body>
</html>
