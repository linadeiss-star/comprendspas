---

import { url, photoUrl, type Entry } from '../lib/content';
import { words, localePath } from '../lib/i18n';
interface Props { entry: Entry }
const { entry } = Astro.props;
const t = words[entry.data.language];
const place = entry.data.location;
---
<article class="spot-layout wrap">
  <div class="spot-photo"><img src={photoUrl(entry.data.cover)} alt={entry.data.coverAlt} width="900" height="1200" fetchpriority="high" /><span class="photo-tag">{t.spotNote}</span></div>
  <div class="spot-copy"><p class="eyebrow">{t.spotKind} / Strasbourg</p><h1>{entry.data.title}</h1><p class="article-deck">{entry.data.description}</p>
    {place && <div class="spot-facts"><strong>{place.name}</strong><span>{place.lat.toFixed(4)}° N · {place.lng.toFixed(4)}° E</span><a href={url(`${localePath(entry.data.language)}?place=${entry.data.translationKey}`)}>{t.findMap}</a></div>}
    <div class="prose"><slot /></div>
  </div>
</article>

