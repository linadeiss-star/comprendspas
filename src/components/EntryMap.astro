---
import { publishedEntries, url, photoUrl, entrySlug } from '../lib/content';
import { words, localePath, type Language } from '../lib/i18n';
interface Props { language?: Language }
const { language = 'en' } = Astro.props;
const t = words[language];
const entries = await publishedEntries(language);
---
<section class="entry-map" id="entry-map">
  <h1 class="sr-only">{t.map} — {t.strasbourg}</h1>
  <div class="entry-map-canvas" role="region" aria-label={t.map}></div>
  {entries.map(entry => {
    const place = entry.data.location;
    return <template data-lat={place.lat} data-lng={place.lng} data-place={entry.data.translationKey} data-kinds={entry.data.kinds.join(' ')}>
      <a class="map-story-preview" href={url(`journal/${entrySlug(entry)}/`)}>
        <img src={photoUrl(entry.data.cover)} alt={entry.data.coverAlt} width="280" height="135" />
        <div><span class="entry-kinds">{entry.data.kinds.map(kind => kind === 'diary' ? t.diaryKind : t.spotKind).join(' + ')}</span><h2>{entry.data.title}</h2><p>{entry.data.description}</p><span class="preview-read">{t.read}</span></div>
      </a>
    </template>;
  })}
  <p class="map-error" role="status" hidden>{t.unavailable} <a href={url(localePath(language, 'journal/'))}>{t.diary}</a></p>
  <noscript><p class="map-error"><a href={url(localePath(language, 'journal/'))}>{t.diary}</a></p></noscript>
  <a class="map-photo-credits" href={url('credits/')}>{t.credits}</a>
</section>
<script>
  import L from 'leaflet';
  import { addColorAreas } from '../lib/map-color-areas';
  import { maplibreGL } from '@maplibre/maplibre-gl-leaflet';
  import { setWorkerUrl, type StyleSpecification } from 'maplibre-gl';
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
  import 'leaflet/dist/leaflet.css';
  import 'maplibre-gl/dist/maplibre-gl.css';
  setWorkerUrl(workerUrl);
  const root = document.querySelector<HTMLElement>('#entry-map')!;
  const canvas = root.querySelector<HTMLElement>('.entry-map-canvas')!;
  const error = root.querySelector<HTMLElement>('.map-error')!;
  const map = L.map(canvas, { zoomControl: false, zoomAnimation: false }).setView([48.581, 7.745], 15);
  L.control.zoom({ position: 'bottomright' }).addTo(map);
  map.setMaxZoom(19);
  async function loadBackground() {
    try {
      const response = await fetch('https://tiles.openfreemap.org/styles/positron');
      if (!response.ok) throw new Error('Map style unavailable');
      const style: StyleSpecification = await response.json();
      // Keep geographic labels, but hide street names, amenities, and map icons.
      style.layers = style.layers.filter(layer => !('source-layer' in layer &&
        ['poi', 'aerodrome_label', 'transportation_name'].includes(layer['source-layer'] || '')));
      const colors: Record<string, string> = {
        water: '#90c5ce', park: '#c3d5ac', landcover_wood: '#b7cda0',
        building: '#e5c5a8', landuse_residential: '#eee1cf',
      };
      for (const layer of style.layers) {
        if (layer.type === 'symbol' && layer.layout) delete layer.layout['icon-image'];
        if (layer.type === 'fill' && colors[layer.id]) {
          layer.paint = { ...layer.paint, 'fill-color': colors[layer.id] };
        }
        if (layer.id === 'waterway' && layer.type === 'line') {
          layer.paint = { ...layer.paint, 'line-color': colors.water };
        }
      }
      const background = maplibreGL({ style }).addTo(map).getMaplibreMap();
      background.on('error', () => { error.hidden = false; });
      background.on('idle', () => { if (background.areTilesLoaded()) error.hidden = true; });
    } catch {
      error.hidden = false;
    }
  }
  void loadBackground();
  const markers = Array.from(root.querySelectorAll('template')).map(template => {
    const preview = template.content.firstElementChild!.cloneNode(true) as HTMLAnchorElement;
    const title = preview.querySelector('h2')!.textContent!;
    const thumbnail = preview.querySelector('img')!.cloneNode() as HTMLImageElement;
    thumbnail.alt = '';
    const kind = template.dataset.kinds!;
    const marker = L.marker([Number(template.dataset.lat), Number(template.dataset.lng)], {
      icon: L.divIcon({ className: `entry-pin ${kind}`, html: thumbnail, iconSize: [60, 60], iconAnchor: [30, 60], popupAnchor: [0, -58] }),
      title, alt: title, riseOnHover: true,
    }).addTo(map).bindPopup(preview, { className: 'story-popup', maxWidth: 280, minWidth: 260 });
    marker.on('mouseover', () => marker.openPopup());
    marker.on('click', () => {
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) location.assign(preview.href);
      else marker.openPopup();
    });
    marker.getElement()?.addEventListener('focus', () => marker.openPopup());
    if (new URLSearchParams(location.search).get('place') === template.dataset.place) marker.openPopup();
    return marker;
  });
  if (markers.length) map.fitBounds(L.latLngBounds(markers.map(marker => marker.getLatLng())), { padding: [65, 90], maxZoom: 16 });
  addColorAreas(map, markers.map(marker => marker.getLatLng()));
  new ResizeObserver(() => map.invalidateSize()).observe(canvas);
  document.addEventListener('keydown', event => { if (event.key === 'Escape') map.closePopup(); });
</script>
